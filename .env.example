# Copy this file to .env and fill in a real key. .env is gitignored -
# never commit real credentials.
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
# Optional - selects server/client transport. Defaults to stdio for local dev.
# TRANSPORT=http
# HOST=0.0.0.0
# PORT=8000
# MCP_SERVER_URL=http://localhost:8000/mcp
